batch_connect:
    template: "basic"
    conn_params:
        - base_out_dir
        - results_url_base
        - run_dir
        - user
        - session_output_dir

script:
    native:
        - "-A kod_proteinfold"
        - "-l select=1:ncpus=2:mem=8gb"
        - "-l walltime=100:00:00"
        - "-N <%= (run_name || 'kod_proteinfold').gsub(' ', '_') %>"
    email:
        - "<%= ENV['USER'] %>@ad.unsw.edu.au"
    email_on_terminated: "<%= email_on_terminated %>"
