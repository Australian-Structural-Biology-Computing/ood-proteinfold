#!/bin/bash

ENV_FILE=".env"
if [ -f "$ENV_FILE" ]; then
    set -a
    . "$ENV_FILE"
    set +a
fi
OOD_SESSION_DIR=$(pwd -P)
# Set defaults to prod if .env is not found
RUN_ENVIRONMENT=${RUN_ENVIRONMENT:-prod}
PROJECT_ROOT=${PROJECT_ROOT:-/srv/scratch/sbf-pipelines/proteinfold}
DB_PATH=${DB_PATH:-/srv/scratch/sbf-pipelines/proteinfold/dbs}
BRANCH="master"
REPOSITORY="Australian-Structural-Biology-Computing/proteinfold"
DEBUGGROUP=${DEBUGGROUP:-sbf}
METRICS_DIRECTORY=${METRICS_DIRECTORY:-/srv/scratch/sbf-pipelines/metrics}
ENABLE_METRICS=${ENABLE_METRICS:-true}

PROTEINFOLD_VERSION="2.1.0dev"

export BRANCH
export PROTEINFOLD_VERSION

set -o pipefail
set -eE

# Open OnDemand preserves this identifier when its Relaunch action creates a
# new batch session. This lets Nextflow reuse state without tying it to a run
# name, which users may legitimately reuse.
RESUME_ID="<%= context.resume_id %>"
if [[ ! "${RESUME_ID}" =~ ^[0-9]{8}_[0-9]{6}_[A-Za-z0-9._-]+$ ]]; then
    echo "ERROR: Invalid ProteinFold resume identifier: ${RESUME_ID}" >&2
    exit 1
fi
RUN_METHOD="<%= context.af_method.to_s.gsub(/[^A-Za-z0-9._-]/, "_") %>"
RUNNAME="${RESUME_ID}_${RUN_METHOD}"

BASE_DEBUGDIR=${BASE_DEBUGDIR:-"/srv/scratch/sbf/debug"}
DEBUGDIR="${BASE_DEBUGDIR}/${RUNNAME}"

BASE_NXF_WORK=${BASE_NXF_WORK:-"/srv/scratch/${USER}/.proteinfold/work"}
RUN_STATE_DIR="${BASE_NXF_WORK}/${RUNNAME}"
LAUNCH_DIR="${RUN_STATE_DIR}/launch"
export NXF_WORK="${RUN_STATE_DIR}/work"
SAMPLESHEET_STATE="${RUN_STATE_DIR}/samplesheet.path"
COMPLETED_MARKER="${RUN_STATE_DIR}/.ood-completed"
DEBUG_LOG="${OOD_SESSION_DIR}/debug.log"
OUTPUT_LOG="${OOD_SESSION_DIR}/output.log"
METRICS_FILE=""

RESUME_RUN=false
if [ -s "${LAUNCH_DIR}/.nextflow/history" ]; then
    RESUME_RUN=true
fi

BASE_OUT_DIR=${BASE_OUT_DIR:-"/srv/scratch/${USER}/proteinfold_output"}
RUN_DIR=$(echo "<%= context.run_name %>" | sed "s#[^A-Za-z0-9]#_#g")
OUT_DIR="${BASE_OUT_DIR}/${RUN_DIR}"

# Write user-facing output live. PBS replaces output.log at stage-out with the
# same stdout/stderr plus its resource-usage footer. debug.log also receives
# Bash command tracing for internal diagnostics.
exec > >(tee -a "${OUTPUT_LOG}" "${DEBUG_LOG}")
exec 2>&1

mkdir -p "${BASE_OUT_DIR}"
mkdir -p "${OUT_DIR}"

if [ -f "${COMPLETED_MARKER}" ]; then
    echo "ProteinFold run ${RUNNAME} already completed successfully."
    echo "Existing results: ${OUT_DIR}"
    echo "Nothing was submitted to Nextflow. Start a new OOD session to run it again."
    exit 0
fi

trap "collect_debug_files" ERR

function collect_debug_files() {
    echo "Error occurred, copying debug files to ${DEBUGDIR}"
    mkdir -p "$DEBUGDIR"
    cp -f "${DEBUG_LOG}" "$DEBUGDIR/" 2>/dev/null || true
    rsync -a --no-perms --no-owner --no-group --max-size=50m . "${NXF_WORK}" "$DEBUGDIR/"
    find "$DEBUGDIR" -type d -exec chmod 2770 {} +
    find "$DEBUGDIR" -type f -exec chmod 660 {} +
    chgrp "$DEBUGGROUP" -R "$DEBUGDIR"
}

function write_completion_metrics() {
    local exit_status="$1"
    if [[ -n "${METRICS_FILE}" && -f "${METRICS_FILE}" ]]; then
        jq --arg finish_date "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
            --argjson exit_status "${exit_status}" \
            '. + {finish_date: $finish_date, exit_status: $exit_status}' \
            "${METRICS_FILE}" > "${METRICS_FILE}.tmp" && mv "${METRICS_FILE}.tmp" "${METRICS_FILE}" || true
    fi
    exit "${exit_status}"
}

trap 'write_completion_metrics "$?"' EXIT

# Set dependency version numbers
VERSION_SAMPLESHEET_UTILS="1.3.4"
source "${PROJECT_ROOT}/${RUN_ENVIRONMENT}/venv/bin/activate"

# Native environment cacheDir used for caching blobs during image pulls
export APPTAINER_CACHEDIR="${APPTAINER_CACHEDIR:-/srv/scratch/${USER}/.images}"
export SINGULARITY_CACHEDIR="${SINGULARITY_CACHEDIR:-/srv/scratch/${USER}/.images}"

# Nextflow variables, checks libraryDir and if image is not found downloads to cache
export NXF_APPTAINER_CACHEDIR="${NXF_APPTAINER_CACHEDIR:-/srv/scratch/${USER}/.images}"
export NXF_SINGULARITY_CACHEDIR="${NXF_SINGULARITY_CACHEDIR:-/srv/scratch/${USER}/.images}"
export NXF_APPTAINER_LIBRARYDIR="${NXF_APPTAINER_LIBRARYDIR:-/srv/scratch/sbf-pipelines/proteinfold/singularity}"
export NXF_SINGULARITY_LIBRARYDIR="${NXF_SINGULARITY_LIBRARYDIR:-/srv/scratch/sbf-pipelines/proteinfold/singularity}"

mkdir -p "${LAUNCH_DIR}" "${NXF_WORK}"
exec {TRACE_FD}>>"${DEBUG_LOG}"
BASH_XTRACEFD="${TRACE_FD}"
set -x
cd "${LAUNCH_DIR}"

function check_depend_version() {
	# Ensure that script is running in prod
	if [ "${RUN_ENVIRONMENT}" == "prod" ]; then
			# Check samplesheet utils
			LOCAL_SAMPLESHEET_VERSION=$(pip3 list 2>&1 | grep samplesheetutils | cut -d' ' -f2)
            if [ "${LOCAL_SAMPLESHEET_VERSION}" != "${VERSION_SAMPLESHEET_UTILS}" ]; then
				echo "VERSION MISMATCH! samplesheet-utils does not match expected version. installed version is ${LOCAL_SAMPLESHEET_VERSION}, expected ${VERSION_SAMPLESHEET_UTILS}"
				exit 1
			fi
	fi
}

check_depend_version

module purge
module load java/21 nextflow/25

# Function to convert colon-delimited sequences to multi-FASTA format
function convert_colon_delimited_to_fasta() {
    local sequence="$1"
    local output_file="$2"
    if [[ "${sequence}" == *":"* ]]; then
        echo "Conversion started..."
        IFS=':' read -ra chains <<< "${sequence}"
        > "${output_file}"
        chain_labels="ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        for i in "${!chains[@]}"; do
            chain_label=${chain_labels:$i:1}
            echo ">${chain_label}" >> "${output_file}"
            echo "${chains[$i]}" >> "${output_file}"
        done
        echo "Converted ${#chains[@]} chains to ${output_file}"
        return 0
    else
        return 1
    fi
}

function strip_all_whitespace() {
    python3 -c '
import sys

print("".join(char for char in sys.stdin.read() if not char.isspace() and char not in {"\ufeff", "\u200b"}), end="")
' <<< "$1"
}

function strip_terminal_stops() {
    python3 -c '
import sys

chains = sys.stdin.read().rstrip("\n").split(":")
print(":".join(chain[:-1] if chain.endswith("*") else chain for chain in chains), end="")
' <<< "$1"
}

function sanitise_input() {
    if python3 "${OOD_SESSION_DIR}/sanitise_input.py" "$@"; then
        return 0
    else
        local status=$?
    fi
    if [ "${status}" -eq 2 ]; then
        return 2
    fi
    echo "WARNING: Input sanitisation failed; continuing with the original input." >&2
    printf '%s\n' "WARNING: Input sanitisation failed; continuing with the original input." >> "$(pwd)/WARNING.txt"
    return 1
}

function sanitise_staged_directory() {
    if sanitise_input directory "./fasta" "$(pwd)/WARNING.txt" "${af_method}"; then
        return 0
    else
        local status=$?
    fi
    if [ "${status}" -eq 2 ]; then
        echo "ERROR: Input validation failed for ${af_method}."
        exit 1
    fi
    return 0
}

function create_and_normalise_samplesheet() {
    create-samplesheet "$@"
    SAMPLESHEET="$(pwd)/samplesheet.csv"
    sanitise_input samplesheet-ids "${SAMPLESHEET}" "$(pwd)/WARNING.txt" || true
}

# Check if the input is an amino acid sequence or a path
raw_user_input="<%= context.samplesheet %>"
user_input="$(printf '%s' "${raw_user_input}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
whitespace_free_sequence="$(strip_all_whitespace "${user_input}")"
sequence_input="$(strip_terminal_stops "${whitespace_free_sequence}")"
af_method="<%= context.af_method %>"

MODE=""
[[ "${sequence_input}" =~ ^[ACDEFGHIKLMNPQRSTVWYX]+(:[ACDEFGHIKLMNPQRSTVWYX]+)*$ ]] && MODE="MANUAL_INPUT"
[[ "${user_input,,}" =~ \.csv$ ]] && MODE="SAMPLESHEET_INPUT"
[[ "${user_input,,}" =~ \.(fa(sta)?|y(a)?ml)$ ]] && MODE="FASTA_INPUT"
[[ "${MODE}" == "" ]] && MODE="DIRECTORY"

if [ "${MODE}" == "MANUAL_INPUT" ] && [ "${RESUME_RUN}" == "false" ]; then
    if [ "${raw_user_input}" != "${whitespace_free_sequence}" ]; then
        echo "WARNING: Removed whitespace from manual sequence input" | tee "$(pwd)/WARNING.txt" >&2
    fi
    if [ "${whitespace_free_sequence}" != "${sequence_input}" ]; then
        echo "WARNING: Removed terminal stop codon from manual sequence input" | tee -a "$(pwd)/WARNING.txt" >&2
    fi
    if [ "${af_method}" == "alphafold2" ] && [[ "${sequence_input}" == *X* ]]; then
        echo "ERROR: AlphaFold2 cannot run sequences containing X."
        exit 1
    fi
    user_input="${sequence_input}"
fi

echo "${MODE}"

# Check YAML/YML compatibility - only supported by Boltz
if [ "${MODE}" == "FASTA_INPUT" ] && [[ "${user_input,,}" =~ \.(yaml|yml)$ ]]; then
    if [ "${af_method}" != "boltz" ]; then
        echo "ERROR: YAML/YML input files are only supported by Boltz."
        echo "Current method: ${af_method}"
        exit 1
    fi
fi

create-samplesheet --version
SAMPLESHEET=""

if [ "${RESUME_RUN}" == "true" ]; then
    if [ ! -s "${SAMPLESHEET_STATE}" ]; then
        echo "ERROR: Cannot resume because the saved samplesheet path is missing: ${SAMPLESHEET_STATE}" >&2
        exit 1
    fi
    IFS= read -r SAMPLESHEET < "${SAMPLESHEET_STATE}"
    if [ -z "${SAMPLESHEET}" ] || [ ! -r "${SAMPLESHEET}" ]; then
        echo "ERROR: Cannot resume because the saved samplesheet is not readable: ${SAMPLESHEET}" >&2
        exit 1
    fi
    echo "Previous Nextflow run found; reusing ${SAMPLESHEET}"
elif [ "${MODE}" == "MANUAL_INPUT" ]; then
    # Check if input contains colon-delimited sequences
    if [[ "${user_input}" == *":"* ]]; then
        echo "Detected colon-delimited sequence input, converting to multi-FASTA format..."
        mkdir -p fasta
        temp_fasta_file="./fasta/converted_multichain.fasta"
        convert_colon_delimited_to_fasta "${user_input}" "${temp_fasta_file}"
        create_and_normalise_samplesheet --directory "./fasta"
        echo "Successfully converted colon-delimited input to multi-FASTA and created samplesheet"
    else
        create_and_normalise_samplesheet --aa-string "${user_input}"
    fi

elif [ "${MODE}" == "SAMPLESHEET_INPUT" ]; then
    if sanitise_input samplesheet "${user_input}" "$(pwd)/sanitised_samplesheet.csv" "$(pwd)/fasta/samplesheet_inputs" "$(pwd)/WARNING.txt" "${af_method}"; then
        SAMPLESHEET="$(pwd)/sanitised_samplesheet.csv"
    else
        sanitise_status=$?
        if [ "${sanitise_status}" -eq 2 ]; then
            echo "ERROR: Input validation failed for ${af_method}."
            exit 1
        fi
        SAMPLESHEET="${user_input}"
    fi

elif [ "${MODE}" == "FASTA_INPUT" ]; then
    mkdir -p fasta
    cp "${user_input}" ./fasta/
    dos2unix ./fasta/*
    sanitise_staged_directory
    create_and_normalise_samplesheet --directory "./fasta"

elif [ "${MODE}" == "DIRECTORY" ]; then
    mkdir -p fasta
    working_dir=$(pwd)
    cd "${user_input}"
    for filename in *
    do
        [ -f "${filename}" ] || continue
        case "${filename,,}" in
            *.fa|*.fasta)
                ;;
            *.yaml|*.yml)
                [ "${af_method}" == "boltz" ] || continue
                ;;
            *)
                continue
                ;;
        esac
        staged_name="${filename//[[:space:]]/-}"
        if [ -e "$working_dir/fasta/${staged_name}" ]; then
            extension="${staged_name##*.}"
            basename="${staged_name%.*}"
            suffix=2
            while [ -e "$working_dir/fasta/${basename}-${suffix}.${extension}" ]; do
                ((suffix += 1))
            done
            staged_name="${basename}-${suffix}.${extension}"
        fi
        cp "${filename}" "$working_dir/fasta/${staged_name}"
    done

    cd ${working_dir}
    staged_inputs=(./fasta/*)
    if [ ! -e "${staged_inputs[0]}" ]; then
        echo "ERROR: No compatible input files were found in ${user_input}."
        exit 1
    fi
    dos2unix "${staged_inputs[@]}"
    sanitise_staged_directory
    create_and_normalise_samplesheet --directory "./fasta"
fi

if [ "${RESUME_RUN}" == "false" ]; then
    printf '%s\n' "${SAMPLESHEET}" > "${SAMPLESHEET_STATE}"
fi

if [ -f "$(pwd)/WARNING.txt" ]; then
    cp "$(pwd)/WARNING.txt" "${OUT_DIR}/WARNING.txt"
fi

PIPELINE_MODE=""
ARGS="--db ${DB_PATH}"
NEXTFLOW_CONFIG_ARGS=("-c" "${PROJECT_ROOT}/kod_proteinfold-${RUN_ENVIRONMENT}.config")
COLABFOLD_RECYCLES="<%= context.colabfold_num_recycles %>"
COLABFOLD_NUM_SEEDS="<%= context.colabfold_num_seeds %>"
RANDOM_SEED="<%= context.random_seed %>"
COLABFOLD_USE_DROPOUT="<%= context.colabfold_use_dropout %>"
COLABFOLD_MAX_MSA="<%= context.colabfold_max_msa %>"
ESMFOLD_RECYCLES="<%= context.esmfold_num_recycles %>"
BOLTZ_USE_POTENTIALS="<%= context.boltz_use_potentials %>"
SAVE_INTERMEDIATES="<%= context.save_intermediates %>"
AF3_WEIGHTS="<%= context.af3_weights %>"

# UI enforces this when ColabFold advanced sampling is active, but keep the
# server-side override as a fallback in case the form state is inconsistent.
if [ "<%= context.colabfold_advanced_options %>" == "yes" ]; then
    SAVE_INTERMEDIATES="true"
fi

if [ "<%= context.full_dbs %>" == "full" ];
then
    FULL_DB="true"
else
    FULL_DB="false"
fi

if [ "<%= context.af_method %>" == "alphafold2" ]; then
    PIPELINE_MODE="alphafold2"
    ARGS="${ARGS} --full_dbs ${FULL_DB}"
    if [ -n "${RANDOM_SEED}" ]; then
        ARGS="${ARGS} --random_seed ${RANDOM_SEED}"
    fi
fi

if [ "<%= context.af_method %>" == "boltz" ]; then
    PIPELINE_MODE="boltz"
    if [ -n "${RANDOM_SEED}" ]; then
        ARGS="${ARGS} --random_seed ${RANDOM_SEED}"
    fi
    if [ "${BOLTZ_USE_POTENTIALS}" == "true" ]; then
        ARGS="${ARGS} --boltz_use_potentials true"
    fi
fi

if [ "<%= context.af_method %>" == "alphafold3" ]; then
    if [ -z "${AF3_WEIGHTS}" ]; then
        echo "ERROR: AlphaFold3 requires a path to user-provided weights."
        exit 1
    fi
    if [ ! -f "${AF3_WEIGHTS}" ] || [ ! -r "${AF3_WEIGHTS}" ]; then
        echo "ERROR: AlphaFold3 weights are not readable: ${AF3_WEIGHTS}"
        exit 1
    fi

    PIPELINE_MODE="alphafold3"
    ARGS="${ARGS} --alphafold3_params_path ${AF3_WEIGHTS}"
fi

if [ "<%= context.af_method %>" == "colabfold" ]; then
    PIPELINE_MODE="colabfold"
    if [ -n "${RANDOM_SEED}" ]; then
        ARGS="${ARGS} --random_seed ${RANDOM_SEED}"
    fi

    if [ -n "${COLABFOLD_RECYCLES}" ]; then
        ARGS="${ARGS} --colabfold_num_recycles ${COLABFOLD_RECYCLES}"
    fi

    COLABFOLD_BATCH_EXTRA_ARGS=""

    if [ -n "${COLABFOLD_NUM_SEEDS}" ]; then
        COLABFOLD_BATCH_EXTRA_ARGS="${COLABFOLD_BATCH_EXTRA_ARGS} --num-seeds ${COLABFOLD_NUM_SEEDS}"
    fi
    if [ "${COLABFOLD_USE_DROPOUT}" == "true" ]; then
        COLABFOLD_BATCH_EXTRA_ARGS="${COLABFOLD_BATCH_EXTRA_ARGS} --use-dropout"
    fi
    if [ -n "${COLABFOLD_MAX_MSA}" ] && [ "${COLABFOLD_MAX_MSA}" != "auto" ]; then
        COLABFOLD_BATCH_EXTRA_ARGS="${COLABFOLD_BATCH_EXTRA_ARGS} --max-msa ${COLABFOLD_MAX_MSA}"
    fi

    if [ -n "${COLABFOLD_BATCH_EXTRA_ARGS}" ]; then
        OOD_COLABFOLD_CONFIG="$(pwd)/ood_colabfold_batch.config"
        cat > "${OOD_COLABFOLD_CONFIG}" <<EOF
process {
    withName: 'COLABFOLD_BATCH' {
        ext.args = '${COLABFOLD_BATCH_EXTRA_ARGS# }'
    }
}
EOF
        NEXTFLOW_CONFIG_ARGS+=("-c" "${OOD_COLABFOLD_CONFIG}")
    fi
fi

if [ "<%= context.af_method %>" == "esmfold" ]; then
    PIPELINE_MODE="esmfold"
    if [ -n "${ESMFOLD_RECYCLES}" ]; then
        ARGS="${ARGS} --esmfold_num_recycles ${ESMFOLD_RECYCLES}"
    fi
fi

if [ "${SAVE_INTERMEDIATES}" == "true" ]; then
    ARGS="${ARGS} --save_intermediates true"
fi

if [[ "${ENABLE_METRICS}" == "true" ]]; then
  # Write metrics before starting the run Create yyyy/mm directory to avoid large file count in one directory and to make collecting metrics by month easier.
  METRICS_LOG_PATH="${METRICS_DIRECTORY}/$(date +%Y/%m)"
  METRICS_FILE="${METRICS_LOG_PATH}/$(date +%Y-%m-%dT%H:%M:%SZ%z)-$(whoami)-${PBS_JOBID%.*}.json"

  # Write json file containing job metrics.
  NF_CONFIG="${NEXTFLOW_CONFIG_ARGS[@]}"
  if ! mkdir -p "${METRICS_LOG_PATH}" || ! jq -n \
      --arg date "$(date +%Y-%m-%dT%H:%M:%SZ%z)" \
      --arg user "$(whoami)" \
      --arg node "$(hostname)" \
      --arg pbs_jobid "${PBS_JOBID}" \
      --arg mode "${PIPELINE_MODE}" \
      --arg repository "${REPOSITORY}" \
      --arg branch "${BRANCH}" \
      --arg input "${SAMPLESHEET}" \
      --arg outdir "${OUT_DIR}" \
      --arg nf_config "${NF_CONFIG}" \
      --arg args "${ARGS}" \
      '{date: $date, user: $user, node: $node, pbs_jobid: $pbs_jobid, mode: $mode, repository: $repository, branch: $branch, input: $input, outdir: $outdir, nf_config: $nf_config, args: $args}' > "${METRICS_FILE}"; then
    echo "Warning: unable to write metrics log to ${METRICS_LOG_PATH}; continuing without metrics." >&2
    METRICS_FILE=""
  fi

fi

NEXTFLOW_RESUME_ARGS=()
if [ "${RESUME_RUN}" == "true" ]; then
    NEXTFLOW_RESUME_ARGS+=("-resume")
fi

nextflow "${NEXTFLOW_CONFIG_ARGS[@]}" run ${REPOSITORY} -r ${BRANCH} -latest \
    --input "${SAMPLESHEET}" \
    --outdir "${OUT_DIR}" \
    --mode "${PIPELINE_MODE}" \
    --use_gpu \
    --monochrome_logs \
    ${ARGS} \
    "${NEXTFLOW_RESUME_ARGS[@]}" \
    -profile apptainer

touch "${COMPLETED_MARKER}"
