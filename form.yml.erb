<%
require "open3"
require "timeout"

scratch_quota_warning = begin
    Timeout.timeout(10) do
        user = ENV.fetch("USER")
        next unless user.match?(/\A[A-Za-z0-9._-]+\z/)
        fileset = "user_#{user}"
        stdout, _stderr, status = Open3.capture3(
            "/usr/lpp/mmfs/bin/mmlsquota", "-Y", "-j", fileset, "kura_rfs2"
        )
        next unless status.success?
        fields = stdout.lines.map { |line| line.chomp.split(":", -1) }
                       .find { |row| row[2] == "0" && row[9] == fileset }
        next unless fields
        block_usage, block_limit, file_usage, file_limit =
            fields.values_at(10, 12, 15, 17).map { |value| Integer(value, exception: false) }
        next unless block_usage && file_usage && block_limit&.positive? && file_limit&.positive?
        storage = 100.0 * block_usage / block_limit
        files = 100.0 * file_usage / file_limit
        { storage: storage, files: files } if storage > 80 || files > 80
    end
rescue StandardError
    nil
end
%>
form:
    - resume_id
    - ood_user
<% if scratch_quota_warning %>
    - scratch_quota_warning
<% end %>
    - data_warning
    - samplesheet
    - samplesheet_help
    - run_name
    - af_method
    - msa_tool
    - colabfold2_params_path
    - af3_warning
    - full_dbs
    - random_seed
    - colabfold_num_recycles
    - colabfold_advanced_options
    - colabfold_max_msa
    - colabfold_num_seeds
    - colabfold_use_dropout
    - save_intermediates
    - generate_plddt_previews
    - citation_request
    - katana_citation

cluster: "katana"

attributes:
    resume_id:
        widget: "hidden_field"
        cacheable: true
        value: ""

    ood_user:
        widget: "hidden_field"
        cacheable: false
        value: "<%= ENV["USER"] %>"

<% if scratch_quota_warning %>
    scratch_quota_warning:
        class: "d-none"
        help: |
            <div role="alert" style="padding: 1rem; margin-bottom: 1rem; background-color: #F8D7DA; border: 3px solid #B00020; border-radius: 0.25rem; color: #721C24; font-size: 1.1rem;">
              <div style="font-size: 1.25rem; font-weight: bold; margin-bottom: 0.5rem;">&#9888; Your scratch quota usage is above 80% of its limit</div>
<% if scratch_quota_warning[:storage]&.>(80.0) %>
              <div><b>Storage usage: <%= scratch_quota_warning[:storage].round(1) %>%</b></div>
<% end %>
<% if scratch_quota_warning[:files]&.>(80.0) %>
              <div><b>File count usage: <%= scratch_quota_warning[:files].round(1) %>%</b></div>
              <div style="margin-top: 0.5rem;">Scratch space also limits how many files and folders you can have, regardless of their size. Large collections of small files can reach this limit even when storage capacity remains available.</div>
              <div style="margin-top: 0.5rem;">If you suspect a particular directory contains many files, advanced users can inspect it with <code>du --inodes --max-depth=1 /path/to/suspected/directory</code>. This may be slow for large directories.</div>
<% end %>
              <div style="margin-top: 0.5rem;"><b>Your job may fail if scratch space runs out.</b> Please remove or archive files you no longer need before submitting.</div>
            </div>
<% end %>

    data_warning:
        class: "d-none"
        help: |
            <div style="padding: 0.375rem 0.75rem; background-color: #E2BEBE; border: 2px solid #761313; border-radius: 0.25rem; color: #761313;">
              <span><b>Warning!</b> Please ensure your input data (e.g., FASTA file or run name) does not contain sensitive data. Katana is <b>NOT</b> suitable for sensitive or highly sensitive data. You should use the UNSW Data Classification scheme to classify your data and learn about managing your research data by visiting the <a style="color: #5B5050" href="https://research.unsw.edu.au/research-data-management-hub">Research Data Management Hub.</a></span>
            </div>

    samplesheet:
        widget: "path_selector"
        label: "Input"
        pattern: "*.csv^"
        placeholder: "path/to/file(s) or sequence 'NLYIQWLKDGGPSSGRPPPS'"
        required: true
    samplesheet_help:
        class: "d-none"
        label: "Input Options"
        help: |
            • <b>Directory:</b> <code>/srv/scratch/z3141592/my_experiment/</code>
            <br>• <b>Single file:</b> <code>protein.fasta</code>, <code>protein.yaml</code>, or <code>samplesheet.csv</code>
            <br>• <b>Sequence:</b> <code>NLYIQWLKDGGPSSGRPPPS</code> or <code>NLYIQWLKDGGPSSGRPPPS:MKTVRQERLKSDHELFRTHT</code>
            <br>📖 <a href="https://unsw.sharepoint.com/sites/StructuralBiologyFacility-UserDocumentation/SitePages/ProteinFold-User-Guide.aspx?ga=1#preparing-your-inputs">User Guide</a> for advanced options.
    run_name:
        widget: "text_field"
        label: "Run Name"
        placeholder: "Enter your run name"
        pattern: '^[A-Za-z0-9_\- ]+$'
        required: true
        help: |
            <a>Alphanumeric characters, spaces, "_", and "-" only.</a>

    af_method:
        widget: "select"
        label: "Method"
        help: |
            Every method predicts through the pipeline's ColabFold2 backend; the AF3-style
            backends accept rich entities (RNA, DNA, ligands) via their JSON/YAML inputs.
            <ul>
                <li><b>AlphaFold2</b> High accuracy, slower; MMseqs2 MSA search - <a href="https://doi.org/10.1038/s41586-021-03819-2">AlphaFold2 paper</a></li>
                <li><b>AlphaFold3</b> High accuracy, Restricted use - <a href="https://doi.org/10.1038/s41586-024-07487-w">AlphaFold3 paper</a></li>
                <li><b>Boltz2</b> High accuracy, faster open AF3-style method - <a href="https://doi.org/10.1101/2024.11.19.624167">Boltz-1 paper</a> <a href="https://doi.org/10.1101/2025.06.14.659707">Boltz-2 paper</a>
                    <ul>
                        <li><i>Runs with the <a href="https://doi.org/10.1101/2025.10.29.684571">LMI4Boltz</a> implementation on Katana, which reduces VRAM requirements and allows larger structure predictions. Accepts Boltz YAML inputs.</i></li>
                    </ul>
                </li>
                <li><b>ESMFold2</b> Medium/Low accuracy, fastest; optional language-model path - <a href="https://doi.org/10.1126/science.ade2574">ESMFold paper</a></li>
                <li><b>Chai1 / Protenix2 / OpenFold3 / OpenBind0 / IntelliFold2 / OpenDDE / RosettaFold3</b> Additional open ColabFold2 backends - see the <a href="https://github.com/sokrypton/ColabFold">ColabFold</a> documentation for entity support per backend.</li>
            </ul>
        options:
            - ["AlphaFold2", "alphafold2", {data-hide-af3_warning: true}]
            - ["AlphaFold3", "alphafold3"]
            - ["Boltz2", "boltz2", {data-hide-af3_warning: true}]
            - ["ESMFold2", "esmfold2", {data-hide-af3_warning: true}]
            - ["Chai1", "chai1", {data-hide-af3_warning: true}]
            - ["Protenix2", "protenix2", {data-hide-af3_warning: true}]
            - ["OpenFold3", "openfold3", {data-hide-af3_warning: true}]
            - ["OpenBind0", "openbind0", {data-hide-af3_warning: true}]
            - ["IntelliFold2", "intellifold2", {data-hide-af3_warning: true}]
            - ["OpenDDE", "opendde", {data-hide-af3_warning: true}]
            - ["RosettaFold3", "rosettafold3", {data-hide-af3_warning: true}]
        display: true

    colabfold2_params_path:
        widget: "path_selector"
        label: "Model Weights Directory"
        placeholder: "Required for AlphaFold3; otherwise the shared weights are used"
        value: "/srv/scratch/sbf-pipelines/proteinfold/colabfold2_params"
        required: false
        help: |
            Path to a ColabFold2 weights root (<code>params/af3/&lt;model&gt;</code> layout).
            <b>Required for AlphaFold3</b>, which needs licensed weights supplied by the user
            (see the warning below). For other methods, leave empty to reuse the complete
            weights under the <code>colabfold2_models</code> directory inside the shared
            proteinfold database path.

    msa_tool:
        widget: "select"
        label: "MSA Generator"
        options:
            - ["ColabFold search (MMseqs2)", "colabfold_search", {data-hide-full_dbs: true}]
            - ["AlphaFold2 pipeline (JackHMMER/hhblits)", "alphafold2_msa"]
            - ["AlphaFold3 data pipeline", "alphafold3_msa", {data-hide-full_dbs: true}]
        value: "colabfold_search"
        display: true
        help: |
            MSA generation is independent of the prediction method; all three generators
            convert their output to the format each backend consumes.
            <ul>
                <li><b>ColabFold search (MMseqs2)</b> Fast local MMseqs2 search against the shared ColabFold databases. Recommended default.</li>
                <li><b>AlphaFold2 pipeline</b> Upstream AlphaFold2 MSA pipeline (JackHMMER/hhblits with template search). Slower; select the MSA Search Database below. Protein templates only.</li>
                <li><b>AlphaFold3 data pipeline</b> Upstream AlphaFold3 feature pipeline (includes RNA and ligand databases). Slowest; recommended for AlphaFold3 runs with rich entities.</li>
            </ul>

    af3_warning:
        class: "d-none"
        label: "AlphaFold3 Warning"
        help: |
            <div style="padding: 0.375rem 0.75rem; background-color: #FBEAEA; border: 2px solid #B42318; border-radius: 0.25rem; color: #7A271A;">
              <p><b>Warning:</b> Users must provide their own weights to run AlphaFold3 predictions. Weights can be requested from Google DeepMind at <a style="color: #0033A0; text-decoration: underline; font-weight: 700;" href="https://github.com/google-deepmind/alphafold3?tab=readme-ov-file#obtaining-model-parameters">this link</a> and are available for restricted use. Please consult the <a style="color: #0033A0; text-decoration: underline; font-weight: 700;" href="https://github.com/google-deepmind/alphafold3/blob/main/WEIGHTS_TERMS_OF_USE.md">terms of use</a> and check with your PI to confirm that this is suitable for your use case.</p>
              <p>AlphaFold3 can <b>NOT</b> be used for:</p>
              <ul>
                <li>Commercial projects.</li>
                <li>Training ML models.</li>
              </ul>
            </div>

    colabfold_num_recycles:
        widget: "number_field"
        label: "Recycles"
        value: 3
        min: 1
        max: 20
        help: |
            Number of recycles used by all prediction methods. Higher values may improve quality but increase runtime.

    full_dbs:
        widget: "select"
        label: "MSA Search Database"
        options:
            - ["Reduced", "reduced"]
            - ["Full", "full"]
        display: true
        help: |
            Only used by the AlphaFold2 MSA pipeline generator. Search the full bfd database with JackHMMER (slower) or cluster representatives with hhblits (faster)
            <ul>
                <li><b>Full</b> High accuracy, slower</li>
                <li><b>Reduced</b> Optimised for speed</li>
            </ul>

    colabfold_advanced_options:
        widget: "check_box"
        label: "Conformational Sampling"
        checked_value: "yes"
        unchecked_value: "no"
        help: |
            Expose advanced options for conformational sampling by varying seeds, dropout, and MSA depth. Supported by the ColabFold2 backends that implement these sampling controls.
            <br>📖 <a href="https://www.ebi.ac.uk/training/online/courses/alphafold/advanced-modeling-and-applications-of-predicted-protein-structures/customising-alphafold-structure-predictions/">ColabFold guide</a>
            <br>📄 Background: <a href="https://elifesciences.org/articles/75751">del Alamo et al. 2022</a>

    random_seed:
        widget: "number_field"
        label: "Random Seed"
        value: 0
        min: 0
        help: |
            Fixed seed for reproducible runs. Default is 0; set a different value to sample alternative runs.

    colabfold_max_msa:
        widget: "select"
        label: "Max MSA"
        options:
            - ["auto", "auto"]
            - ["512:1024", "512:1024"]
            - ["256:512", "256:512"]
            - ["64:128", "64:128"]
            - ["32:64", "32:64"]
            - ["16:32", "16:32"]
        value: "auto"
        help: |
            Notebook-style MSA depth preset in the form max_seq:max_extra_seq. Lower values can increase diversity at the cost of confidence.

    colabfold_num_seeds:
        widget: "select"
        label: "Number of Seeds"
        options:
            - ["1", "1"]
            - ["2", "2"]
            - ["4", "4"]
            - ["8", "8"]
            - ["16", "16"]
        value: "1"
        help: |
            Number of seeds to sample. Higher values increase runtime and produce more sampled conformations.

    colabfold_use_dropout:
        widget: "check_box"
        label: "Dropout"
        checked_value: "true"
        unchecked_value: "false"
        help: |
            Enable dropout during inference to increase sampling diversity.

    save_intermediates:
        widget: "check_box"
        label: "Save Intermediate Files"
        checked_value: "true"
        unchecked_value: "false"
        help: |
                        Save intermediate prediction files and additional (non-top-ranked) results.

                        <div id="save_intermediates_warning" class="d-none" role="status" aria-live="polite" style="padding: 0.375rem 0.75rem; background-color: #E2BEBE; border: 2px solid #761313; border-radius: 0.25rem; color: #761313; margin-top:0.5rem;">
                            <span><b>Warning!</b> Enabling this can significantly increase output size especially for AlphaFold2. Ensure that your scratch storage is sufficient and consider cleaning up the files after use.</span>
                        </div>
                        <div id="save_intermediates_enforced" class="d-none" role="status" aria-live="polite" style="margin-top:0.5rem; font-style: italic; color: #5B5050;">
                            This option is enabled and locked while conformational sampling is active.
                        </div>

    generate_plddt_previews:
        widget: "check_box"
        label: "Generate pLDDT Mugshot Images"
        checked_value: "true"
        unchecked_value: "false"
        checked: true
        help: |
            Create front, side, and top confidence-coloured previews, each with its predicted aligned error (PAE) plot where the model provides one, in a standalone gallery under <code>mugshots/</code>.

    citation_request:
        label: "Facility Citation"
        class: "d-none"
        help: |
            Please include the following acknowledgement in publications that use this resource:
            <br>
            <i>"The authors acknowledge use of facilities in the Structural Biology Facility within the Mark Wainwright Analytical Centre - UNSW"</i>
            <br>
            <b>DOI:</b> <a href="https://doi.org/10.26190/4KQF-M552">10.26190/4KQF-M552</a>

    katana_citation:
        label: "Katana HPC Citation"
        class: "d-none"
        help: |
            Please include the following acknowledgement in publications that use Katana:
            <br>
            <i>"This research includes computations using the computational cluster Katana supported by Research Technology Services at UNSW Sydney."</i>
            <br>
            <b>DOI:</b> <a href="https://doi.org/10.26190/669x-a286">10.26190/669X-A286</a>
